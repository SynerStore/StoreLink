{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron 主进程调试",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "runtimeArgs": ["--inspect=9229", "${workspaceFolder}/build/main.js"],
      "env": {
        "NODE_ENV": "development"
      },
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/build/**/*.js"],
      "preLaunchTask": "npm: dev:main"
    },
    {
      "name": "Attach 主进程（npm start）",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "cwd": "${workspaceFolder}",
      "timeout": 10000,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/build/**/*.js"],
      "preLaunchTask": "npm: start"
    },
    {
      "name": "通过 npm start 启动并调试主进程",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/build/**/*.js"]
    }
  ]
}
