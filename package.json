{
  "name": "stor-link-client",
  "version": "0.0.1",
  "description": "An App for management your multiple storeage",
  "main": "main.js",
  "keywords": [
    "electron",
    "react",
    "rspack"
  ],
  "author": "chrissong1994 <chrissong1994@163.com> ",
  "license": "MIT",
  "scripts": {
    "start": "cross-env NODE_ENV=development electron --inspect=9229 ./build/main.js",
    "dev": "npm run clean:build && concurrently \"npm run dev:renderer\"  \"npm run dev:main\"",
    "dev:renderer": "cross-env NODE_ENV=development rspack serve -c ./scripts/rspack.render.config.ts",
    "build:renderer": "cross-env NODE_ENV=production rspack build -c ./scripts/rspack.render.config.ts",
    "dev:main": "cross-env NODE_ENV=development rspack build -c  ./scripts/rspack.main.config.ts -w",
    "build:main": "cross-env NODE_ENV=production rspack build -c ./scripts/rspack.main.config.ts",
    "build": "npm run clean:build && npm run build:renderer && npm run build:main",
    "clean:build": "rimraf ./build",
    "install:rclone": "./scripts/update-rclone-binaries.sh ",
    "make": "npm run build && node scripts/make.js",
    "make:mac": "cross-env MAKE_FOR=mac npm run make",
    "make:win": "cross-env MAKE_FOR=win npm run make",
    "make:linux": "cross-env MAKE_FOR=linux npm run make",
    "prettier": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,less,md}\"",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@rspack/cli": "^1.7.0",
    "@rspack/core": "^1.7.0",
    "@rspack/plugin-react-refresh": "^1.5.3",
    "@types/ali-oss": "^6.16.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.16",
    "@types/lodash-es": "^4.17.12",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ssh2-sftp-client": "^9.0.6",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.8",
    "@arco-themes/react-syner-store": "^0.0.1",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.782.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fett/utils": "^0.0.8",
    "@fontsource/roboto": "^5.2.5",
    "@uiw/react-markdown-preview": "^5.1.3",
    "ali-oss": "^6.22.0",
    "better-sqlite3": "^12.5.0",
    "cos-nodejs-sdk-v5": "^2.14.6",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "electron-devtools-installer": "^4.0.0",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.3.1",
    "electron-store": "^10.0.1",
    "file-type": "^20.4.0",
    "fs-extra": "^11.3.0",
    "highlight.js": "^11.11.1",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.22",
    "lowdb": "^7.0.1",
    "mime-types": "^2.1.35",
    "node-machine-id": "^1.1.12",
    "normalize.css": "^8.0.1",
    "pdfjs-dist": "^5.1.91",
    "picocolors": "^1.1.1",
    "proxy-agent": "^6.5.0",
    "query-string": "^9.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.6.1",
    "react-refresh": "^0.16.0",
    "react-resizable": "^3.0.5",
    "react-syntax-highlighter": "^15.6.1",
    "readdirp": "^4.1.2",
    "samba-client": "^7.2.0",
    "ssh2-sftp-client": "^12.0.1",
    "uuid": "^11.1.0",
    "video.js": "^8.22.0",
    "webdav": "^5.8.0",
    "zustand": "^5.0.3"
  }
}
